{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standings.schema.json",
  "title": "StandingsData",
  "description": "各賽季各組別的戰績（只計例行賽、排除黃金決勝局）；由 src.export.site_data 產出",
  "type": "object",
  "additionalProperties": false,
  "required": ["standings"],
  "properties": {
    "standings": {
      "type": "array",
      "items": {
        "title": "GroupStandings",
        "type": "object",
        "additionalProperties": false,
        "required": ["cup_id", "group", "note", "rows"],
        "properties": {
          "cup_id": { "type": "integer" },
          "group": { "type": "string", "enum": ["men", "women"] },
          "note": { "type": ["string", "null"], "description": "資料不完整等註記；無則 null" },
          "rows": {
            "type": "array",
            "items": {
              "title": "StandingsEntry",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rank", "team_id", "wins", "losses", "win_pct", "set_record", "points",
                "sets_won", "sets_lost", "set_ratio", "points_for", "points_against", "point_ratio", "last5"
              ],
              "properties": {
                "rank": { "type": "integer", "minimum": 1 },
                "team_id": { "type": "integer" },
                "wins": { "type": "integer", "minimum": 0 },
                "losses": { "type": "integer", "minimum": 0 },
                "win_pct": { "type": ["number", "null"], "description": "勝場／場次；無場次為 null" },
                "set_record": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["3-0", "3-1", "3-2", "2-3", "1-3", "0-3"],
                  "properties": {
                    "3-0": { "type": "integer", "minimum": 0 },
                    "3-1": { "type": "integer", "minimum": 0 },
                    "3-2": { "type": "integer", "minimum": 0 },
                    "2-3": { "type": "integer", "minimum": 0 },
                    "1-3": { "type": "integer", "minimum": 0 },
                    "0-3": { "type": "integer", "minimum": 0 }
                  }
                },
                "points": { "type": "integer", "minimum": 0 },
                "sets_won": { "type": "integer", "minimum": 0 },
                "sets_lost": { "type": "integer", "minimum": 0 },
                "set_ratio": { "type": ["number", "null"], "description": "勝局／敗局；敗局為 0 則 null" },
                "points_for": { "type": "integer", "minimum": 0 },
                "points_against": { "type": "integer", "minimum": 0 },
                "point_ratio": { "type": ["number", "null"], "description": "得分／失分；失分為 0 則 null" },
                "last5": {
                  "type": "array",
                  "maxItems": 5,
                  "items": { "type": "string", "enum": ["W", "L"] },
                  "description": "最近五場例行賽結果，由舊到新"
                }
              }
            }
          }
        }
      }
    }
  }
}
