{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leaders.schema.json",
  "title": "LeadersData",
  "description": "各賽季各組別的排行榜（只計有單場數據的球員、排除黃金決勝局）；由 src.export.site_data 產出，沒有單場數據的季組不輸出",
  "type": "object",
  "additionalProperties": false,
  "required": ["leaders"],
  "properties": {
    "leaders": {
      "type": "array",
      "items": {
        "title": "GroupLeaders",
        "type": "object",
        "additionalProperties": false,
        "required": ["cup_id", "group", "through_date", "games", "boards"],
        "properties": {
          "cup_id": { "type": "integer" },
          "group": { "type": "string", "enum": ["men", "women"] },
          "through_date": { "type": ["string", "null"], "format": "date", "description": "已有單場數據的最後一場日期；查無可對回賽程的場次為 null" },
          "games": { "type": "integer", "minimum": 0, "description": "已有單場數據且對得回賽程的場次數" },
          "boards": {
            "type": "array",
            "items": {
              "title": "LeaderBoard",
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "kind", "threshold", "rows"],
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "kind": { "type": "string", "enum": ["count", "rate"], "description": "count 計數榜；rate 比率榜" },
                "threshold": { "type": ["string", "null"], "description": "比率榜的門檻描述；計數榜為 null" },
                "rows": {
                  "type": "array",
                  "items": {
                    "title": "LeaderRow",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "rank", "player_id", "name", "team_id", "team_short", "position",
                      "value", "numerator", "denominator", "title"
                    ],
                    "properties": {
                      "rank": { "type": "integer", "minimum": 1, "description": "同值並列同名次，下一名跳號" },
                      "player_id": { "type": "integer" },
                      "name": { "type": "string" },
                      "team_id": { "type": "integer" },
                      "team_short": { "type": "string" },
                      "position": { "type": ["string", "null"] },
                      "value": { "type": "number" },
                      "numerator": { "type": ["integer", "null"], "description": "比率榜的分子；計數榜為 null" },
                      "denominator": { "type": ["integer", "null"], "description": "比率榜的分母；計數榜為 null" },
                      "title": { "type": ["string", "null"], "description": "第一名稱號（如得分王）；其餘為 null" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
