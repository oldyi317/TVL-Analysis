{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team_advanced.schema.json",
  "title": "TeamAdvancedData",
  "description": "各賽季各組別的球隊指標（全隊分子總和除以分母總和，排除黃金決勝局）；由 src.export.site_data 產出，沒有單場數據的季組不輸出",
  "type": "object",
  "additionalProperties": false,
  "required": ["team_advanced"],
  "properties": {
    "team_advanced": {
      "type": "array",
      "items": {
        "title": "GroupTeamAdvanced",
        "type": "object",
        "additionalProperties": false,
        "required": ["cup_id", "group", "teams"],
        "properties": {
          "cup_id": { "type": "integer" },
          "group": { "type": "string", "enum": ["men", "women"] },
          "teams": {
            "type": "array",
            "items": {
              "title": "TeamAdvanced",
              "type": "object",
              "additionalProperties": false,
              "required": ["team_id", "games", "points", "metrics", "trend"],
              "properties": {
                "team_id": { "type": "integer" },
                "games": { "type": "integer", "minimum": 1, "description": "已有單場數據且對得回賽程的場次數" },
                "points": {
                  "title": "TeamPoints",
                  "description": "整季得分來源（排除黃金決勝局）；對手失誤得分是逐場推算值：該場比分總分減全隊攻擊、攔網、發球得分，再加總；推算可能為負",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["attack", "block", "serve", "opponent_error", "total"],
                  "properties": {
                    "attack": { "type": "integer", "minimum": 0 },
                    "block": { "type": "integer", "minimum": 0 },
                    "serve": { "type": "integer", "minimum": 0 },
                    "opponent_error": { "type": "integer", "description": "推算值，可能為負" },
                    "total": { "type": "integer", "minimum": 0, "description": "各局比分加總" }
                  }
                },
                "metrics": {
                  "title": "TeamMetrics",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "attack_success_rate", "serve_point_rate", "receive_excellent_rate",
                    "dig_excellent_rate", "set_excellent_rate", "blocks_per_set"
                  ],
                  "properties": {
                    "attack_success_rate": { "$ref": "#/$defs/metric" },
                    "serve_point_rate": { "$ref": "#/$defs/metric" },
                    "receive_excellent_rate": { "$ref": "#/$defs/metric" },
                    "dig_excellent_rate": { "$ref": "#/$defs/metric" },
                    "set_excellent_rate": { "$ref": "#/$defs/metric" },
                    "blocks_per_set": { "$ref": "#/$defs/metric", "description": "分母為該隊在比分中實際打的局數" }
                  }
                },
                "trend": {
                  "description": "逐場趨勢：每場的六項球隊指標，依日期排序，不含黃金決勝局",
                  "type": "array",
                  "items": {
                    "title": "TeamTrendGame",
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["game_id", "date", "opponent_id", "metrics"],
                    "properties": {
                      "game_id": { "type": "integer" },
                      "date": { "type": "string", "format": "date" },
                      "opponent_id": { "type": ["integer", "null"], "description": "對手球隊編號；比分列沒有對應到球隊時為 null" },
                      "metrics": {
                        "title": "TeamGameMetrics",
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "attack_success_rate", "serve_point_rate", "receive_excellent_rate",
                          "dig_excellent_rate", "set_excellent_rate", "blocks_per_set"
                        ],
                        "properties": {
                          "attack_success_rate": { "$ref": "#/$defs/gameMetric" },
                          "serve_point_rate": { "$ref": "#/$defs/gameMetric" },
                          "receive_excellent_rate": { "$ref": "#/$defs/gameMetric" },
                          "dig_excellent_rate": { "$ref": "#/$defs/gameMetric" },
                          "set_excellent_rate": { "$ref": "#/$defs/gameMetric" },
                          "blocks_per_set": { "$ref": "#/$defs/gameMetric", "description": "分母為該場比分的局數" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gameMetric": {
      "title": "TeamGameMetric",
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "value": { "type": ["number", "null"], "description": "同 TeamMetric.value；分母為 0 時為 null" }
      }
    },
    "metric": {
      "title": "TeamMetric",
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value", "rank"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "value": { "type": ["number", "null"], "description": "率類為百分比、每局攔網為每局次數，四捨五入到小數 2 位；分母為 0 時為 null" },
        "rank": { "type": ["integer", "null"], "minimum": 1, "description": "組別內名次，同值並列同名次、下一名跳號；value 為 null 時為 null" }
      }
    }
  }
}
